                         C      ;
                         C      ; Test der RAM-Disk - Size (256 / 512 / 1024 / 2048 KByte)
                         C      ; ------------------------
                         C      ;
  EFDC    AF             C      RDTEST: XOR  A            ;Kapazitaet der RAM-Disk testen
  EFDD    D3 E6          C              OUT  (RDADR+6),A  ;H-Adresse ruecksetzen
  EFDF    0E E0          C              LD   C,RDADR      ;Test erfolgt in der 1. RAM-Bank
                         C      ;
                         C      ; Inhalte der 4 RAM-Testzellen sichern
                         C      ;
  EFE1    21 EEE1        C              LD   HL,RDMERK    ;Merkzellen im RAM
  EFE4    06 04          C              LD   B,4          ;4 Durchlaeufe
  EFE6    16 04          C              LD   D,4          ;Startwert Extended-Adresse
  EFE8    AF             C      RDTST1: XOR  A
  EFE9    D3 E7          C              OUT  (RDADR+7),A  ;L-Adresse ruecksetzen
  EFEB    7A             C              LD   A,D
  EFEC    D3 E5          C              OUT  (RDADR+5),A  ;Extended-Adresse auswaehlen
  EFEE    ED 78          C              IN   A,(C)
  EFF0    77             C              LD   (HL),A       ;Daten aus der RAM-Disk sichern
  EFF1    23             C              INC  HL           ;Merkzelle++
  EFF2    CB 3A          C              SRL  D            ;0 --> D7 --> D0 --> CY
  EFF4    10 F2          C              DJNZ RDTST1
                         C      ;
                         C      ; 4 Testwerte in die RAM-Disk schreiben
                         C      ;
  EFF6    06 04          C              LD   B,4          ;4 Durchlaeufe
  EFF8    16 04          C              LD   D,4          ;Startwert Extended-Adresse
  EFFA    AF             C      RDTST2: XOR  A
  EFFB    D3 E7          C              OUT  (RDADR+7),A  ;L-Adresse ruecksetzen
  EFFD    7A             C              LD   A,D
  EFFE    D3 E5          C              OUT  (RDADR+5),A  ;Extended-Adresse auswaehlen
  F000    ED 79          C              OUT  (C),A        ;Testwert in die RAM-Disk schreiben
  F002    CB 3A          C              SRL  D            ;0 --> D7 --> D0 --> CY
  F004    10 F4          C              DJNZ RDTST2
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                         C      ;
                         C      ;Tabelle der Test-Werte (mit *...* sind die zu testenden Werte):
                         C      ;
                         C      ;           RAM-Disk-Size =   256K   512K  1024K  2048K
                         C      ;Extended-Adresse=00000100B    0      0      0     *4*
                         C      ;Extended-Adresse=00000010B    0      0     *2*     2
                         C      ;Extended-Adresse=00000001B    0     *1*     1      1
                         C      ;Extended-Adresse=00000000B   *0*     0      0      0
                         C      ;
                         C      ; Groesse der RAM-Disk bestimmen
                         C      ;
