  F006    28 07          C              JR   Z,RDTST4     ;2048(B=4),1024(B=3),512(B=2),256(B=1)
  F008    CB 3A          C              SRL  D            ;0 --> D7 --> D0 --> CY
  F00A    10 F1          C              DJNZ RDTST3
