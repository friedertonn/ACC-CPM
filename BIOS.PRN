	MACRO-80 3.44	09-Dec-81	PAGE	1


                                
                                        .CREF
                                        .Z80
                                ;
                                ;       ****************************************************************
                                ;       *                                                              *
                                ;       *  ACC-BIOS fuer den AC1-2010                                  *
                                ;       *                                                              *
                                ;       *  11.11.2026                                                  *
                                ;       *                                                              *
                                ;       *  LW A: Praecitronic RAM-Disk 256 - 2048 KByte                *
                                ;       *  LW B: Floppylaufwerk MFM1.6 780/800 KByte                   *
                                ;       *  LW C: Floppylaufwerk MFM1.6 800 KByte                       *
                                ;       *  Tastatur mit Interruptsteuerung                             *
                                ;       *  Bildschirmausgabe nach ACC-Dresden                          *
                                ;       *  automatische RAM-Disk Groessenerkennung 256K bis 2048K      *
                                ;       *  Umschaltung LW B: 780K/800K mit dem 'DISK'-Befehl           *
                                ;       *                                                              *
                                ;       ****************************************************************
                                ;
  0001                          FLOPPY  EQU  1            ;BIOS mit RamDisk A: und Floppy B: und C:
                                ;
                                        IF1
                                        .PRINTX 'PASS 1'
                                        IFDEF FLOPPY
                                        .PRINTX 'BIOS mit RamDisk A: und Floppy B:, C:'
                                        ELSE
                                        .PRINTX 'BIOS mit RamDisk A: (kein Floppy-Drive)'
                                        ENDIF
                                        ENDIF
                                ;
                                        IF2
                                        .PRINTX 'PASS 2'
                                        ENDIF
                                ;
  0003                          IOBYTE  EQU  0003H
  0004                          LWBYTE  EQU  0004H        ;LW (Bit 0-3) + USER Nr.(Bit 4-7)
  07FD                          GETCO   EQU  07FDH        ;Ruecksprung in den AC1-Monitor
                                IFDEF FLOPPY
  D000                          CCP     EQU  0D000H       ;Startadresse CCP = 0D000h mit Floppy
                                ELSE
                                CCP     EQU  0E000H       ;Startadresse CCP = 0E000h ohne Floppy
                                ENDIF
  D806                          BDOS    EQU  CCP+806H     ;Startadresse BDOS
  E600                          BIOS    EQU  CCP+1600H    ;Startadresse BIOS
                                ;
  0006                          PIO1AC  EQU  06H          ;PIO1 Port A Control
  0004                          PIO1AD  EQU  04H          ;PIO1 Port A Data
  0007                          PIO1BC  EQU  07H          ;PIO1 Port B Control
  0005                          PIO1BD  EQU  05H          ;PIO1 Port B Data
  001E                          MAP     EQU  1EH          ;Seitenschaltung nach FA
                                ;
  0000                          AC1MOD  EQU  0            ;AC1 - Mode
  0001                          CPMMOD  EQU  1            ;CP/M - Mode
                                ;
  FF80                          IV      EQU  0FF80H       ;Interrupt-Vektoren von 0xFF80 bis 0xFF9F
                                ;
                                        .PHASE BIOS
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


  E600    C3 E688                       JP   BOOT
  E603    C3 E733               BIOSWB: JP   WBOOT
  E606    C3 F23F                       JP   CONST
  E609    C3 F1E6                       JP   CONIN
  E60C    C3 F06F                       JP   CONOUT
  E60F    C3 F2B9                       JP   LIST
  E612    C3 F2BF                       JP   PUNCH
  E615    C3 F2C2                       JP   READER
  E618    C3 E66A                       JP   HOME
  E61B    C3 E641                       JP   SELDSK
  E61E    C3 E66C                       JP   SETTRK
  E621    C3 E665                       JP   SETSEC
  E624    C3 E671                       JP   SETDMA
  E627    C3 F2A8                       JP   READ
  E62A    C3 F297                       JP   WRITE
  E62D    C3 F2BC                       JP   LISTST
  E630    C3 E660                       JP   SECTRN
                                ;
  E633    43 50 4D 41                   DEFM 'CPMAC'      ;fuer PC/BC Progr.
  E637    43                    
  E638    C3 F401                       JP   EXIT         ;EXIT-Kommando
                                        IFDEF FLOPPY
  E63B    C3 E780                       JP   DISK         ;DISK-Umschaltung B: 780K <--> 800K
                                        ELSE
                                        JP   0000H
                                        ENDIF
  E63E    C3 0000                       JP   0000H        ;3. User-Befehl
                                ;
  E641    21 0000               SELDSK: LD   HL,0         ;HL=0 --> kein LW
  E644    3A F427                       LD   A,(NDISK)    ;Anzahl der LW
  E647    5F                            LD   E,A
  E648    79                            LD   A,C          ;C = akt. LW
  E649    BB                            CP   E
  E64A    D0                            RET  NC           ;akt. LW >= NDISK
  E64B    32 F428                       LD   (DRIVE),A    ;Merker fuer akt. LW
  E64E    FE 00                         CP   0            ;RAM-Disk?
  E650    28 04                         JR   Z,SELDS1
                                        IFDEF FLOPPY
  E652    3D                            DEC  A
  E653    32 EAC5                       LD   (UNIT),A     ;Floppy-Drive 0=780K, 1=800K
                                        ENDIF
  E656    69                    SELDS1: LD   L,C
  E657    29                            ADD  HL,HL
  E658    29                            ADD  HL,HL
  E659    29                            ADD  HL,HL
  E65A    29                            ADD  HL,HL
  E65B    11 F371                       LD   DE,DPH
  E65E    19                            ADD  HL,DE        ;zugeordneter DPH --> HL
  E65F    C9                            RET
                                ;
  E660    26 00                 SECTRN: LD   H,0          ;CP/A-Routine fuer 8 Bit
  E662    69                            LD   L,C
  E663    23                            INC  HL
  E664    C9                            RET
                                ;
  E665    79                    SETSEC: LD   A,C
  E666    32 EABE                       LD   (SECTOR),A
  E669    C9                            RET
                                ;
  E66A    0E 00                 HOME:   LD   C,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  E66C    79                    SETTRK: LD   A,C
  E66D    32 EAC6                       LD   (TRACK),A
  E670    C9                            RET
                                ;
  E671    ED 43 EABF            SETDMA: LD   (DMA),BC
  E675    C9                            RET
                                ;
  E676                          PLATZ:  DEFS BIOS+80H-PLATZ-5,0
                                ;
  E67B    00                    TZ:     DEFB 0            ;Fuellstand Tastaturpuffer
  E67C    E680                  TZOUT:  DEFW TAPU         ;Ausgabezeiger
  E67E    E680                  TZIN:   DEFW TAPU         ;Eingabezeiger
  E680                          TAPU:   DEFS 8,0          ;Tastatur-Ringpuffer
                                ;
                                        .PRINTX '--> BOOT'
                         C      $INCLUDE BOOT.INC
                         C      ;       ****************
                         C      ;       *              *
                         C      ;       * BOOT & WBOOT *
                         C      ;       *              *
                         C      ;       ****************
                         C      ;
                         C      ;11.11.2026
                         C      ;
  E688    F3             C      BOOT:   DI
  E689    31 0080        C              LD   SP,80H
                         C      ;
  E68C    21 FF00        C              LD   HL,0FF00H    ;Speicherbereich von 0xFF00 bis 0xFF9F
  E68F    36 00          C              LD   (HL),0       ;loeschen (wegen DVU, DVHD)
  E691    11 FF01        C              LD   DE,0FF01H
  E694    01 009F        C              LD   BC,9FH
  E697    ED B0          C              LDIR
  E699    21 F24A        C              LD   HL,ISRTAS    ;Einsprungpunkt PIO1-Tastatur-Interrupt
  E69C    22 FF88        C              LD   (IV+8),HL    ;auf Adr. 0FF88h eintragen
                         C      ;
  E69F    ED 5E          C              IM   2            ;Bitmode Interrupt
  E6A1    3E FF          C              LD   A,HIGH(IV)
  E6A3    ED 47          C              LD   I,A
  E6A5    3E 88          C              LD   A,LOW(IV+8)  ;Interruptvektor PIO 1A
  E6A7    D3 06          C              OUT  (PIO1AC),A
  E6A9    3E CF          C              LD   A,0CFH       ;PIO - Mode 3
  E6AB    D3 06          C              OUT  (PIO1AC),A
  E6AD    3E FF          C              LD   A,0FFH       ;alles Eingaenge
  E6AF    D3 06          C              OUT  (PIO1AC),A
  E6B1    3E B7          C              LD   A,0B7H       ;Int.-st.-wort
  E6B3    D3 06          C              OUT  (PIO1AC),A
  E6B5    3E 7F          C              LD   A,7FH        ;Int.-maske
  E6B7    D3 06          C              OUT  (PIO1AC),A
  E6B9    AF             C              XOR  A            ;Interruptvektor PIO 1B
  E6BA    D3 07          C              OUT  (PIO1BC),A
  E6BC    3E CF          C              LD   A,0CFH       ;PIO - Mode 3
  E6BE    D3 07          C              OUT  (PIO1BC),A
  E6C0    3E 84          C              LD   A,84H        ;BIT 2 & 7 = Eingang
  E6C2    D3 07          C              OUT  (PIO1BC),A
  E6C4    3E 07          C              LD   A,07H        ;Int.-st.-wort
  E6C6    D3 07          C              OUT  (PIO1BC),A
                         C      ;
  E6C8    3E DA          C              LD   A,0DAH       ;SCCH-Monitor Initialisierung
  E6CA    CB 9F          C              RES  3,A          ;ACC-Zeichensatz einschalten
  E6CC    D3 05          C              OUT  (PIO1BD),A
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                         C      ;
  E6CE    3E 01          C              LD   A,CPMMOD
  E6D0    D3 1E          C              OUT  (MAP),A
                         C      ;
  E6D2    21 F2E8        C              LD   HL,TEXT1     ;Systemueberschrift
  E6D5    CD F2D7        C              CALL OUTTXT
  E6D8    CD EFDC        C              CALL RDTEST       ;Kapazitaet der RAM-Disk bestimmen
  E6DB    3A EEE5        C              LD   A,(RDSIZE)   ;RD-Size: 0=256K 1=512K 2=1024K 3=2048K
  E6DE    21 F3F2        C              LD   HL,DP2048    ;DPB 2048K RAM-Disk
  E6E1    DD 21 F336     C              LD   IX,TEXT1D    ;Text: "A:RAM-Disk 2048K"
  E6E5    FE 03          C              CP   3
  E6E7    28 1C          C              JR   Z,BOOT2
  E6E9    21 F3E3        C              LD   HL,DP1024    ;DPB 1024K RAM-Disk
  E6EC    DD 21 F330     C              LD   IX,TEXT1C    ;Text: "A:RAM-Disk 1024K"
  E6F0    FE 02          C              CP   2
  E6F2    28 11          C              JR   Z,BOOT2
  E6F4    21 F3D4        C              LD   HL,DP512     ;DPB 512K RAM-Disk
  E6F7    DD 21 F32B     C              LD   IX,TEXT1B    ;Text: "A:RAM-Disk 512K"
  E6FB    FE 01          C              CP   1
  E6FD    28 06          C              JR   Z,BOOT2
  E6FF    DD 21 F326     C              LD   IX,TEXT1A    ;Text: "A:RAM-Disk 256K"
  E703    18 08          C              JR   BOOT3        ;256K RAM-Disk, kein LDIR
                         C      ;        
  E705    11 F3A1        C      BOOT2:  LD   DE,DPB0
  E708    01 000F        C              LD   BC,15
  E70B    ED B0          C              LDIR
  E70D    DD E5          C      BOOT3:  PUSH IX           ;RAM-Disk Text --> HL
  E70F    E1             C              POP  HL
  E710    CD F2D7        C              CALL OUTTXT
  E713    21 F33C        C              LD   HL,TEXT1E    ;Text: "B:Floppy 780K ..."
  E716    CD F2D7        C              CALL OUTTXT
                         C      ;
  E719    CD EF2A        C              CALL INITRD       ;RAM-Disk Initialisierung
                         C              IFNDEF FLOPPY
                         C              CALL CCPWR        ;CCP + BDOS --> RAM-Disk
                         C              ENDIF             ;bei jedem BOOT ausgef.
                         C      ;
  E71C    AF             C              XOR  A
  E71D    32 0003        C              LD   (IOBYTE),A   ;IOBYTE
  E720    32 0004        C              LD   (LWBYTE),A   ;akt. LW
                         C              IFDEF FLOPPY
  E723    32 EADE        C              LD   (BLTEST),A   ;HST-Kennung ruecksetzen
                         C              ENDIF
                         C      ;
                         C      ; den FileCommander von 7600h auf 100h kopieren
  E726    21 7600        C              LD   HL,7600H
  E729    11 0100        C              LD   DE,0100H
  E72C    01 5A00        C              LD   BC,5A00H     ;5A00h Bytes
  E72F    ED B0          C              LDIR
                         C      ;
  E731    18 1E          C              JR   WBOOT1       ;CCP-Read ueberspringen
                         C      ;
  E733    F3             C      WBOOT:  DI
  E734    31 0080        C              LD   SP,80H
                         C              IFDEF FLOPPY
  E737    CD E8C7        C              CALL WRITE4       ;alten HST-Sector schr.
                         C              ENDIF
  E73A    CD EFBA        C              CALL CCPRD        ;CCP + BDOS laden
  E73D    3A F427        C              LD   A,(NDISK)    ;Anzahl der LW
  E740    4F             C              LD   C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  E741    3A 0004        C              LD   A,(LWBYTE)
  E744    E6 0F          C              AND  0FH          ;LW testen
  E746    B9             C              CP   C
  E747    38 08          C              JR   C,WBOOT1     ;akt. LW < NDISK
  E749    3A 0004        C              LD   A,(LWBYTE)
  E74C    E6 F0          C              AND  0F0H         ;LW ruecksetzen
  E74E    32 0004        C              LD   (LWBYTE),A
  E751    AF             C      WBOOT1: XOR  A
                         C              IFDEF FLOPPY
  E752    32 EAC4        C              LD   (CTAB),A     ;letzter FDC-Befehl
                         C              ENDIF
  E755    3E C3          C              LD   A,0C3H
  E757    32 0000        C              LD   (0),A        ;JP WBOOT eintragen
  E75A    21 E603        C              LD   HL,BIOSWB
  E75D    22 0001        C              LD   (1),HL
  E760    32 0005        C              LD   (5),A        ;JP BDOS eintragen
  E763    21 D806        C              LD   HL,BDOS
  E766    22 0006        C              LD   (6),HL
  E769    32 0038        C              LD   (38H),A      ;JP ERROR eintragen
  E76C    21 F2CB        C              LD   HL,ERROR
  E76F    22 0039        C              LD   (39H),HL
  E772    01 0080        C              LD   BC,80H
  E775    CD E671        C              CALL SETDMA       ;DMA --> 80H
  E778    3A 0004        C              LD   A,(LWBYTE)
  E77B    4F             C              LD   C,A          ;aktuelles LW
  E77C    FB             C              EI
  E77D    C3 D000        C              JP   CCP          ;JP CCP
                         C      ;
                                ;
                                IFDEF FLOPPY
                                        .PRINTX '--> DISKSET'
                         C      $INCLUDE DISKSET.INC
                         C      ;       ******************************
                         C      ;       *                            *
                         C      ;       * Diskettenformat einstellen *
                         C      ;       *                            *
                         C      ;       ******************************
                         C      ;
                         C      ;23.10.2025
                         C      ;
  E780    3A E7AB        C      DISK:   LD   A,(DSKSET)
  E783    3C             C              INC  A
  E784    CB 8F          C              RES  1,A
  E786    32 E7AB        C              LD   (DSKSET),A   ;0=800K, 1=780K
  E789    21 E7AC        C              LD   HL,DPB800
  E78C    CB 47          C              BIT  0,A
  E78E    28 03          C              JR   Z,DISK1
  E790    21 E7BD        C              LD   HL,DPB780
  E793    11 F3B2        C      DISK1:  LD   DE,DPB1      ;Disk Parameter Block LW B:
  E796    01 0011        C              LD   BC,17
  E799    ED B0          C              LDIR
  E79B    21 E7CE        C              LD   HL,DSK800    ;800K Floppy-Disk
  E79E    FE 00          C              CP   0
  E7A0    28 03          C              JR   Z,DISK2
  E7A2    21 E7E5        C              LD   HL,DSK780    ;780K Floppy-Disk
  E7A5    CD F2D7        C      DISK2:  CALL OUTTXT
  E7A8    C3 E733        C              JP   WBOOT        ;Warmstart
                         C      ;
  E7AB    01             C      DSKSET: DEFB 1            ;beim Kaltstart: 780K
                         C      ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  E7AC    0050           C      DPB800: DEFW 80           ;80 Sectoren/Track
  E7AE    04             C              DEFB 4            ;Blockgroesse = 2 Kbyte
  E7AF    0F             C              DEFB 15
  E7B0    00             C              DEFB 0
  E7B1    018F           C              DEFW 399          ;400 * 2 Kbyte - Bloecke
  E7B3    00BF           C              DEFW 191          ;192 DIR - Eintraege
  E7B5    00E0           C              DEFW 0E0H         ;3 DIR-Bloecke
  E7B7    0030           C              DEFW 48
  E7B9    0000           C              DEFW 0            ;0 Kbyte System
                         C      ;
  E7BB    0000           C              DEFW 0
                         C      ;
  E7BD    0050           C      DPB780: DEFW 80           ;80 Sectoren/Track
  E7BF    04             C              DEFB 4            ;Blockgroesse = 2 Kbyte
  E7C0    0F             C              DEFB 15
  E7C1    00             C              DEFB 0
  E7C2    0185           C              DEFW 389          ;390 * 2 Kbyte - Bloecke
  E7C4    007F           C              DEFW 127          ;128 DIR - Eintraege
  E7C6    00C0           C              DEFW 0C0H         ;pro DIR-Block 1Bit gesetzt
  E7C8    0020           C              DEFW 32
  E7CA    0002           C              DEFW 2            ;20 Kbyte System
                         C      ;
  E7CC    0000           C              DEFW 0
                         C      ;
  E7CE    0D 0A          C      DSK800: DEFB 0DH,0AH
  E7D0    2D 2D 2D 3E    C              DEFM '---> Drive B:=800K'
  E7D4    20 44 72 69    C      
  E7D8    76 65 20 42    C      
  E7DC    3A 3D 38 30    C      
  E7E0    30 4B          C      
  E7E2    0D 0A 00       C              DEFB 0DH,0AH,00H
  E7E5    0D 0A          C      DSK780: DEFB 0DH,0AH
  E7E7    2D 2D 2D 3E    C              DEFM '---> Drive B:=780K'
  E7EB    20 44 72 69    C      
  E7EF    76 65 20 42    C      
  E7F3    3A 3D 37 38    C      
  E7F7    30 4B          C      
  E7F9    0D 0A 00       C              DEFB 0DH,0AH,00H
                         C      ;
