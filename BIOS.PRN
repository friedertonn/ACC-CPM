                                ;
                                        .PRINTX '--> RAMDISK'
                         C      $INCLUDE RAMDISK.INC
                         C      ;       *************************
                         C      ;       *                       *
                         C      ;       * Praecitronic RAM-Disk *
                         C      ;       *                       *
                         C      ;       *************************
                         C      ;
                         C      ;10.04.2024
                         C      ;
                         C      ;Die RAM-Disk hat eine Organisation von 256 Tracks
                         C      ;und 64 Sectoren/Track (8K / Track).
                         C      ;Track 0 ist fuer CCP + BDOS reserviert (8K Systemtrack).
                         C      ;
  00E0                   C      RDADR   EQU  0E0H         ;Grund-Adresse der RAM-Disk
                         C      ;
  EEE1                   C      RDMERK: DEFS 4,0          ;4 Merkzellen fuer den RAM-Disk Test
  EEE5    00             C      RDSIZE: DEFB 0            ;RD-Size: 0=256K 1=512K 2=1024K 3=2048K
                         C      ;
                         C      ; RAM-Disk lesen
                         C      ; --------------
                         C      ;
  EEE6    CD EEF4        C      RDRDSK: CALL RDARI
  EEE9    ED B2          C              INIR
  EEEB    AF             C              XOR  A
  EEEC    C9             C              RET
                         C      ;
                         C      ; RAM-Disk schreiben
                         C      ; ------------------
                         C      ;
  EEED    CD EEF4        C      WRRDSK: CALL RDARI
  EEF0    ED B3          C              OTIR
  EEF2    AF             C              XOR  A
  EEF3    C9             C              RET
                         C      ;
                         C      ; Disk-Adresse bestimmen
                         C      ; ----------------------
                         C      ;
  EEF4    3A EAC6        C      RDARI:  LD   A,(TRACK)    ;TTTTTTTT
  EEF7    6F             C              LD   L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  EEF8    3A EABE        C              LD   A,(SECTOR)   ;00SSSSSS
  EEFB    A7             C              AND  A
  EEFC    CA F2C5        C              JP   Z,DERROR     ;Zugriff auf Sektor 0
  EEFF    5F             C              LD   E,A
  EF00    1D             C              DEC  E            ;CP/A beginnt mit Sektor 1
  EF01    AF             C              XOR  A
  EF02    67             C              LD   H,A
  EF03    57             C              LD   D,A
