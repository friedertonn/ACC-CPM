	MACRO-80 3.44	09-Dec-81	PAGE	1


                                
                                        .CREF
                                        .Z80
                                ;
                                ;       ****************************************************************
                                ;       *                                                              *
                                ;       *  ACC-BIOS fuer den AC1-2010                                  *
                                ;       *                                                              *
                                ;       *  14.11.2025                                                  *
                                ;       *                                                              *
                                ;       *  LW A: Praecitronic RAM-Disk 256 - 2048 KByte                *
                                ;       *  LW B: Floppylaufwerk MFM1.6 780/800 KByte                   *
                                ;       *  LW C: Floppylaufwerk MFM1.6 800 KByte                       *
                                ;       *  Tastatur mit Interruptsteuerung                             *
                                ;       *  Bildschirmausgabe nach ACC-Dresden                          *
                                ;       *  automatische RAM-Disk Groessenerkennung 256K bis 2048K      *
                                ;       *  Umschaltung LW B: 780K/800K mit dem 'DISK'-Befehl           *
                                ;       *                                                              *
                                ;       ****************************************************************
                                ;
  0001                          FLOPPY  EQU  1            ;BIOS mit RamDisk A: und Floppy B: und C:
                                ;
                                        IF1
                                        .PRINTX 'PASS 1'
                                        IFDEF FLOPPY
                                        .PRINTX 'BIOS mit RamDisk A: und Floppy B:, C:'
                                        ELSE
                                        .PRINTX 'BIOS mit RamDisk A: (kein Floppy-Drive)'
                                        ENDIF
                                        ENDIF
                                ;
                                        IF2
                                        .PRINTX 'PASS 2'
                                        ENDIF
                                ;
  0003                          IOBYTE  EQU  0003H
  0004                          LWBYTE  EQU  0004H        ;LW (Bit 0-3) + USER Nr.(Bit 4-7)
  07FD                          GETCO   EQU  07FDH        ;Ruecksprung in den AC1-Monitor
                                IFDEF FLOPPY
  D000                          CCP     EQU  0D000H       ;Startadresse CCP = 0D000h mit Floppy
                                ELSE
                                CCP     EQU  0E000H       ;Startadresse CCP = 0E000h ohne Floppy
                                ENDIF
  D806                          BDOS    EQU  CCP+806H     ;Startadresse BDOS
  E600                          BIOS    EQU  CCP+1600H    ;Startadresse BIOS
                                ;
  0006                          PIO1AC  EQU  06H          ;PIO1 Port A Control
  0004                          PIO1AD  EQU  04H          ;PIO1 Port A Data
  0007                          PIO1BC  EQU  07H          ;PIO1 Port B Control
  0005                          PIO1BD  EQU  05H          ;PIO1 Port B Data
  001E                          MAP     EQU  1EH          ;Seitenschaltung nach FA
                                ;
  0000                          AC1MOD  EQU  0            ;AC1 - Mode
  0001                          CPMMOD  EQU  1            ;CP/M - Mode
                                ;
                                        .PHASE BIOS
                                ;
  E600    C3 E68A                       JP   BOOT
  E603    C3 E726               BIOSWB: JP   WBOOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


  E606    C3 F227                       JP   CONST
  E609    C3 F1DB                       JP   CONIN
  E60C    C3 F062                       JP   CONOUT
  E60F    C3 F2CC                       JP   LIST
  E612    C3 F2D2                       JP   PUNCH
  E615    C3 F2D5                       JP   READER
  E618    C3 E66A                       JP   HOME
  E61B    C3 E641                       JP   SELDSK
  E61E    C3 E66C                       JP   SETTRK
  E621    C3 E665                       JP   SETSEC
  E624    C3 E671                       JP   SETDMA
  E627    C3 F2BB                       JP   READ
  E62A    C3 F2AA                       JP   WRITE
  E62D    C3 F2CF                       JP   LISTST
  E630    C3 E660                       JP   SECTRN
                                ;
  E633    43 50 4D 41                   DEFM 'CPMAC'      ;fuer PC/BC Progr.
  E637    43                    
  E638    C3 F414                       JP   EXIT         ;EXIT-Kommando
                                        IFDEF FLOPPY
  E63B    C3 E773                       JP   DISK         ;DISK-Umschaltung B: 780K <--> 800K
                                        ELSE
                                        JP   0000H
                                        ENDIF
  E63E    C3 0000                       JP   0000H        ;3. User-Befehl
                                ;
  E641    21 0000               SELDSK: LD   HL,0         ;HL=0 --> kein LW
  E644    3A F43A                       LD   A,(NDISK)    ;Anzahl der LW
  E647    5F                            LD   E,A
  E648    79                            LD   A,C          ;C = akt. LW
  E649    BB                            CP   E
  E64A    D0                            RET  NC           ;akt. LW >= NDISK
  E64B    32 F43B                       LD   (DRIVE),A    ;Merker fuer akt. LW
  E64E    FE 00                         CP   0            ;RAM-Disk?
  E650    28 04                         JR   Z,SELDS1
                                        IFDEF FLOPPY
  E652    3D                            DEC  A
  E653    32 EAB8                       LD   (UNIT),A     ;Floppy-Drive 0=780K, 1=800K
                                        ENDIF
  E656    69                    SELDS1: LD   L,C
  E657    29                            ADD  HL,HL
  E658    29                            ADD  HL,HL
  E659    29                            ADD  HL,HL
  E65A    29                            ADD  HL,HL
  E65B    11 F384                       LD   DE,DPH
  E65E    19                            ADD  HL,DE        ;zugeordneter DPH --> HL
  E65F    C9                            RET
                                ;
  E660    26 00                 SECTRN: LD   H,0          ;CP/A-Routine fuer 8 Bit
  E662    69                            LD   L,C
  E663    23                            INC  HL
  E664    C9                            RET
                                ;
  E665    79                    SETSEC: LD   A,C
  E666    32 EAB1                       LD   (SECTOR),A
  E669    C9                            RET
                                ;
  E66A    0E 00                 HOME:   LD   C,0
  E66C    79                    SETTRK: LD   A,C
  E66D    32 EAB9                       LD   (TRACK),A
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  E670    C9                            RET
                                ;
  E671    ED 43 EAB2            SETDMA: LD   (DMA),BC
  E675    C9                            RET
                                ;
  E676                          PLATZ:  DEFS BIOS+80H-PLATZ-5,0
                                ;
  E67B    00                    TZ:     DEFB 0            ;Fuellstand Tastaturpuffer
  E67C    E680                  TZOUT:  DEFW TAPU         ;Ausgabezeiger
  E67E    E680                  TZIN:   DEFW TAPU         ;Eingabezeiger
  E680                          TAPU:   DEFS 8,0          ;Tastatur-Ringpuffer
                                ;
  E688    F23F                  IV:     DEFW INTA         ;Int.-Vektor fuer CONIN (PIO)
                                ;
                                        .PRINTX '--> BOOT'
                         C      $INCLUDE BOOT.INC
                         C      ;       ****************
                         C      ;       *              *
                         C      ;       * BOOT & WBOOT *
                         C      ;       *              *
                         C      ;       ****************
                         C      ;
                         C      ;14.11.2025
                         C      ;
  E68A    F3             C      BOOT:   DI
  E68B    31 0080        C              LD   SP,80H
  E68E    ED 5E          C              IM   2            ;Bitmode Interrupt
  E690    3E E6          C              LD   A,HIGH(IV)
  E692    ED 47          C              LD   I,A
  E694    3E 88          C              LD   A,LOW(IV)    ;Interruptvektor PIO 1A
  E696    D3 06          C              OUT  (PIO1AC),A
  E698    3E CF          C              LD   A,0CFH       ;PIO - Mode 3
  E69A    D3 06          C              OUT  (PIO1AC),A
  E69C    3E FF          C              LD   A,0FFH       ;alles Eingaenge
  E69E    D3 06          C              OUT  (PIO1AC),A
  E6A0    3E B7          C              LD   A,0B7H       ;Int.-st.-wort
  E6A2    D3 06          C              OUT  (PIO1AC),A
  E6A4    3E 7F          C              LD   A,7FH        ;Int.-maske
  E6A6    D3 06          C              OUT  (PIO1AC),A
  E6A8    AF             C              XOR  A            ;Interruptvektor PIO 1B
  E6A9    D3 07          C              OUT  (PIO1BC),A
  E6AB    3E CF          C              LD   A,0CFH       ;PIO - Mode 3
  E6AD    D3 07          C              OUT  (PIO1BC),A
  E6AF    3E 84          C              LD   A,84H        ;BIT 2 & 7 = Eingang
  E6B1    D3 07          C              OUT  (PIO1BC),A
  E6B3    3E 07          C              LD   A,07H        ;Int.-st.-wort
  E6B5    D3 07          C              OUT  (PIO1BC),A
                         C      ;
  E6B7    3E DA          C              LD   A,0DAH       ;SCCH-Monitor Initialisierung
  E6B9    CB 9F          C              RES  3,A          ;ACC-Zeichensatz einschalten
  E6BB    D3 05          C              OUT  (PIO1BD),A
                         C      ;
  E6BD    3E 01          C              LD   A,CPMMOD
  E6BF    D3 1E          C              OUT  (MAP),A
                         C      ;
  E6C1    21 F2FB        C              LD   HL,TEXT1     ;Systemueberschrift
  E6C4    CD F2EA        C              CALL OUTTXT
  E6C7    CD EFCF        C              CALL RDTEST       ;Kapazitaet der RAM-Disk bestimmen
  E6CA    3A EED8        C              LD   A,(RDSIZE)   ;RD-Size: 0=256K 1=512K 2=1024K 3=2048K
  E6CD    21 F405        C              LD   HL,DP2048    ;DPB 2048K RAM-Disk
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  E6D0    DD 21 F349     C              LD   IX,TEXT1D    ;Text: "A:RAM-Disk 2048K"
  E6D4    FE 03          C              CP   3
  E6D6    28 1C          C              JR   Z,BOOT2
  E6D8    21 F3F6        C              LD   HL,DP1024    ;DPB 1024K RAM-Disk
  E6DB    DD 21 F343     C              LD   IX,TEXT1C    ;Text: "A:RAM-Disk 1024K"
  E6DF    FE 02          C              CP   2
  E6E1    28 11          C              JR   Z,BOOT2
  E6E3    21 F3E7        C              LD   HL,DP512     ;DPB 512K RAM-Disk
  E6E6    DD 21 F33E     C              LD   IX,TEXT1B    ;Text: "A:RAM-Disk 512K"
  E6EA    FE 01          C              CP   1
  E6EC    28 06          C              JR   Z,BOOT2
  E6EE    DD 21 F339     C              LD   IX,TEXT1A    ;Text: "A:RAM-Disk 256K"
  E6F2    18 08          C              JR   BOOT3        ;256K RAM-Disk, kein LDIR
                         C      ;        
  E6F4    11 F3B4        C      BOOT2:  LD   DE,DPB0
  E6F7    01 000F        C              LD   BC,15
  E6FA    ED B0          C              LDIR
  E6FC    DD E5          C      BOOT3:  PUSH IX           ;RAM-Disk Text --> HL
  E6FE    E1             C              POP  HL
  E6FF    CD F2EA        C              CALL OUTTXT
  E702    21 F34F        C              LD   HL,TEXT1E    ;Text: "B:Floppy 780K ..."
  E705    CD F2EA        C              CALL OUTTXT
                         C      ;
  E708    CD EF1D        C              CALL INITRD       ;RAM-Disk Initialisierung
                         C              IFNDEF FLOPPY
                         C              CALL CCPWR        ;CCP + BDOS --> RAM-Disk
                         C              ENDIF             ;bei jedem BOOT ausgef.
                         C      ;
  E70B    AF             C              XOR  A
  E70C    32 0003        C              LD   (IOBYTE),A   ;IOBYTE
  E70F    32 0004        C              LD   (LWBYTE),A   ;akt. LW
                         C              IFDEF FLOPPY
  E712    32 EAD1        C              LD   (BLTEST),A   ;HST-Kennung ruecksetzen
                         C              ENDIF
                         C      ;
                         C      ; den FileCommander von 7600h auf 100h kopieren
  E715    21 7600        C              LD   HL,7600H
  E718    11 0100        C              LD   DE,0100H
  E71B    01 5A00        C              LD   BC,5A00H     ;5A00h Bytes
  E71E    ED B0          C              LDIR
                         C      ;
  E720    F3             C              DI
  E721    31 0080        C              LD   SP,80H
  E724    18 1E          C              JR   WBOOT1       ;CCP-Read ueberspringen
                         C      ;
  E726    F3             C      WBOOT:  DI
  E727    31 0080        C              LD   SP,80H
                         C              IFDEF FLOPPY
  E72A    CD E8BA        C              CALL WRITE4       ;alten HST-Sector schr.
                         C              ENDIF
  E72D    CD EFAD        C              CALL CCPRD        ;CCP + BDOS laden
  E730    3A F43A        C              LD   A,(NDISK)    ;Anzahl der LW
  E733    4F             C              LD   C,A
  E734    3A 0004        C              LD   A,(LWBYTE)
  E737    E6 0F          C              AND  0FH          ;LW testen
  E739    B9             C              CP   C
  E73A    38 08          C              JR   C,WBOOT1     ;akt. LW < NDISK
  E73C    3A 0004        C              LD   A,(LWBYTE)
  E73F    E6 F0          C              AND  0F0H         ;LW ruecksetzen
  E741    32 0004        C              LD   (LWBYTE),A
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  E744    AF             C      WBOOT1: XOR  A
                         C              IFDEF FLOPPY
  E745    32 EAB7        C              LD   (CTAB),A     ;letzter FDC-Befehl
                         C              ENDIF
  E748    3E C3          C              LD   A,0C3H
  E74A    32 0000        C              LD   (0),A        ;JP WBOOT eintragen
  E74D    21 E603        C              LD   HL,BIOSWB
  E750    22 0001        C              LD   (1),HL
  E753    32 0005        C              LD   (5),A        ;JP BDOS eintragen
  E756    21 D806        C              LD   HL,BDOS
  E759    22 0006        C              LD   (6),HL
  E75C    32 0038        C              LD   (38H),A      ;JP ERROR eintragen
  E75F    21 F2DE        C              LD   HL,ERROR
  E762    22 0039        C              LD   (39H),HL
  E765    01 0080        C              LD   BC,80H
  E768    CD E671        C              CALL SETDMA       ;DMA --> 80H
  E76B    3A 0004        C              LD   A,(LWBYTE)
  E76E    4F             C              LD   C,A          ;aktuelles LW
  E76F    FB             C              EI
  E770    C3 D000        C              JP   CCP          ;JP CCP
                         C      ;
                                ;
                                IFDEF FLOPPY
                                        .PRINTX '--> DISKSET'
                         C      $INCLUDE DISKSET.INC
                         C      ;       ******************************
                         C      ;       *                            *
                         C      ;       * Diskettenformat einstellen *
                         C      ;       *                            *
                         C      ;       ******************************
                         C      ;
                         C      ;23.10.2025
                         C      ;
  E773    3A E79E        C      DISK:   LD   A,(DSKSET)
  E776    3C             C              INC  A
  E777    CB 8F          C              RES  1,A
  E779    32 E79E        C              LD   (DSKSET),A   ;0=800K, 1=780K
  E77C    21 E79F        C              LD   HL,DPB800
  E77F    CB 47          C              BIT  0,A
  E781    28 03          C              JR   Z,DISK1
  E783    21 E7B0        C              LD   HL,DPB780
  E786    11 F3C5        C      DISK1:  LD   DE,DPB1      ;Disk Parameter Block LW B:
  E789    01 0011        C              LD   BC,17
  E78C    ED B0          C              LDIR
  E78E    21 E7C1        C              LD   HL,DSK800    ;800K Floppy-Disk
  E791    FE 00          C              CP   0
  E793    28 03          C              JR   Z,DISK2
  E795    21 E7D8        C              LD   HL,DSK780    ;780K Floppy-Disk
  E798    CD F2EA        C      DISK2:  CALL OUTTXT
  E79B    C3 E726        C              JP   WBOOT        ;Warmstart
                         C      ;
  E79E    01             C      DSKSET: DEFB 1            ;beim Kaltstart: 780K
                         C      ;
  E79F    0050           C      DPB800: DEFW 80           ;80 Sectoren/Track
  E7A1    04             C              DEFB 4            ;Blockgroesse = 2 Kbyte
  E7A2    0F             C              DEFB 15
  E7A3    00             C              DEFB 0
  E7A4    018F           C              DEFW 399          ;400 * 2 Kbyte - Bloecke
  E7A6    00BF           C              DEFW 191          ;192 DIR - Eintraege
  E7A8    00E0           C              DEFW 0E0H         ;3 DIR-Bloecke
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  E7AA    0030           C              DEFW 48
  E7AC    0000           C              DEFW 0            ;0 Kbyte System
                         C      ;
  E7AE    0000           C              DEFW 0
                         C      ;
  E7B0    0050           C      DPB780: DEFW 80           ;80 Sectoren/Track
  E7B2    04             C              DEFB 4            ;Blockgroesse = 2 Kbyte
  E7B3    0F             C              DEFB 15
  E7B4    00             C              DEFB 0
  E7B5    0185           C              DEFW 389          ;390 * 2 Kbyte - Bloecke
  E7B7    007F           C              DEFW 127          ;128 DIR - Eintraege
  E7B9    00C0           C              DEFW 0C0H         ;pro DIR-Block 1Bit gesetzt
  E7BB    0020           C              DEFW 32
  E7BD    0002           C              DEFW 2            ;20 Kbyte System
                         C      ;
  E7BF    0000           C              DEFW 0
                         C      ;
  E7C1    0D 0A          C      DSK800: DEFB 0DH,0AH
  E7C3    2D 2D 2D 3E    C              DEFM '---> Drive B:=800K'
  E7C7    20 44 72 69    C      
  E7CB    76 65 20 42    C      
  E7CF    3A 3D 38 30    C      
  E7D3    30 4B          C      
  E7D5    0D 0A 00       C              DEFB 0DH,0AH,00H
  E7D8    0D 0A          C      DSK780: DEFB 0DH,0AH
  E7DA    2D 2D 2D 3E    C              DEFM '---> Drive B:=780K'
  E7DE    20 44 72 69    C      
  E7E2    76 65 20 42    C      
  E7E6    3A 3D 37 38    C      
  E7EA    30 4B          C      
  E7EC    0D 0A 00       C              DEFB 0DH,0AH,00H
                         C      ;
