                                        .PRINTX '--> FLOPPY'
                         C      $INCLUDE FLOPPY.INC
                         C      ;       ***********************
                         C      ;       *                     *
                         C      ;       * Floppy - Controller *
                         C      ;       *                     *
                         C      ;       ***********************
                         C      ;
                         C      ;14.11.2025
                         C      ;
                         C      ;Sectorberechnung Floppy
                         C      ;-----------------------
                         C      ;IN:  SECTOR aktueller BDOS-Sector
                         C      ;     SECTR letzter Disk-Sector
                         C      ;OUT: SECTR aktueller Disk-Sector
                         C      ;     DE DMA-Zeiger
                         C      ;     Z=0 neuer Disksector
                         C      ;     Z=1 Sector weiter bearbeiten
                         C      ;
  0040                   C      CFDC    EQU  40H
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  0041                   C      DFDC    EQU  41H
  0044                   C      DL175   EQU  44H          ;ehem. 48H
  0043                   C      AKWAIT  EQU  43H          ;ehem. 50H
                         C      ;
  E7FC    21 EABE        C      CPSEC:  LD   HL,SECTOR
  E7FF    E5             C              PUSH HL
  E800    3A EAC9        C              LD   A,(N)        ;Diskettenformat
  E803    4F             C              LD   C,A
  E804    47             C              LD   B,A          ;Maske errechnen
  E805    AF             C              XOR  A
  E806    37             C      CPSEC1: SCF
  E807    17             C              RLA
  E808    10 FC          C              DJNZ CPSEC1
  E80A    35             C              DEC  (HL)
  E80B    A6             C              AND  (HL)         ;n. Sec. im Diskblock
  E80C    21 EA61        C              LD   HL,FDMA-80H  ;FDMA-Zeiger ber.
  E80F    11 0080        C              LD   DE,80H
  E812    47             C              LD   B,A          ;n. Sector im FDMA
  E813    04             C              INC  B
  E814    19             C      CPSEC2: ADD  HL,DE
  E815    10 FD          C              DJNZ CPSEC2
  E817    EB             C              EX   DE,HL
  E818    41             C              LD   B,C          ;(N)
  E819    E1             C              POP  HL           ;SECTOR
  E81A    7E             C              LD   A,(HL)
  E81B    34             C              INC  (HL)
  E81C    CB 3F          C      CPSEC3: SRL  A
  E81E    10 FC          C              DJNZ CPSEC3       ;B=0 (Kopf1)
                         C      ;
                         C      ;Kopf berechnen
                         C      ;--------------
                         C      ;
  E820    4F             C              LD   C,A
  E821    3A EACA        C              LD   A,(EOT)      ;DSectoren je Spur
  E824    3D             C              DEC  A
  E825    21 EAC8        C              LD   HL,SECTR
  E828    91             C              SUB  C
  E829    30 04          C              JR   NC,INHEAD    ;Kopf 1
  E82B    2F             C              CPL               ;bitweise negieren
  E82C    06 01          C              LD   B,1          ;Kopf 2
  E82E    4F             C              LD   C,A
  E82F    79             C      INHEAD: LD   A,C
  E830    35             C              DEC  (HL)
  E831    BE             C              CP   (HL)
  E832    F5             C              PUSH AF
  E833    71             C              LD   (HL),C       ;DSector eintragen
  E834    34             C              INC  (HL)         ;Sec. rel. zu 1
  E835    2B             C              DEC  HL
  E836    70             C              LD   (HL),B       ;Kopf eintragen
  E837    CB 20          C              SLA  B
  E839    CB 20          C              SLA  B
  E83B    2B             C              DEC  HL
  E83C    2B             C              DEC  HL           ;UNIT
  E83D    3A EAC5        C              LD   A,(UNIT)
  E840    E6 03          C              AND  3            ;Maske fuer LW 1-4
  E842    B0             C              OR   B
  E843    77             C              LD   (HL),A       ;Kopf n, LW x
  E844    F1             C              POP  AF
  E845    C9             C              RET
                         C      ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


                         C      ;Vergleich letzter LW-Zugriff
                         C      ;----------------------------
                         C      ;
  E846    21 EAC4        C      CPLW:   LD   HL,CTAB      ;Vergl. Operation
  E849    BE             C              CP   (HL)
  E84A    20 21          C              JR   NZ,CPLW1
  E84C    21 EAC4        C      CPLW3:  LD   HL,CTAB
  E84F    11 EACE        C              LD   DE,RESLT     ;Vergleich LW
  E852    1A             C              LD   A,(DE)
  E853    23             C              INC  HL
  E854    AE             C              XOR  (HL)
  E855    E6 03          C              AND  3            ;nur Bit 0 und 1 vergl.
  E857    20 14          C              JR   NZ,CPLW1
  E859    23             C              INC  HL           ;Vergleich Spur
  E85A    13             C              INC  DE
  E85B    13             C              INC  DE
  E85C    13             C              INC  DE
  E85D    3A EAD3        C              LD   A,(RESLT+5)  ;Sector+1
  E860    3D             C              DEC  A            ;1. Sec. der next Spur?
  E861    1A             C              LD   A,(DE)
  E862    20 01          C              JR   NZ,CPLW2
  E864    3D             C              DEC  A            ;1 Spur zurueck
  E865    BE             C      CPLW2:  CP   (HL)
  E866    20 05          C              JR   NZ,CPLW1
  E868    23             C              INC  HL
  E869    13             C              INC  DE           ;Vergleich Kopf
  E86A    1A             C              LD   A,(DE)
  E86B    BE             C              CP   (HL)
  E86C    C8             C              RET  Z
  E86D    04             C      CPLW1:  INC  B
