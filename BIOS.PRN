                                        .PRINTX '--> FLOPPY'
                         C      $INCLUDE FLOPPY.INC
                         C      ;       ***********************
                         C      ;       *                     *
                         C      ;       * Floppy - Controller *
                         C      ;       *                     *
                         C      ;       ***********************
                         C      ;
                         C      ;14.11.2025
                         C      ;
                         C      ;Sectorberechnung Floppy
                         C      ;-----------------------
                         C      ;IN:  SECTOR aktueller BDOS-Sector
                         C      ;     SECTR letzter Disk-Sector
                         C      ;OUT: SECTR aktueller Disk-Sector
                         C      ;     DE DMA-Zeiger
                         C      ;     Z=0 neuer Disksector
                         C      ;     Z=1 Sector weiter bearbeiten
                         C      ;
  0040                   C      CFDC    EQU  40H
  0041                   C      DFDC    EQU  41H
  0044                   C      DL175   EQU  44H          ;ehem. 48H
  0043                   C      AKWAIT  EQU  43H          ;ehem. 50H
                         C      ;
  E7EF    21 EAB1        C      CPSEC:  LD   HL,SECTOR
  E7F2    E5             C              PUSH HL
  E7F3    3A EABC        C              LD   A,(N)        ;Diskettenformat
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  E7F6    4F             C              LD   C,A
  E7F7    47             C              LD   B,A          ;Maske errechnen
  E7F8    AF             C              XOR  A
  E7F9    37             C      CPSEC1: SCF
  E7FA    17             C              RLA
  E7FB    10 FC          C              DJNZ CPSEC1
  E7FD    35             C              DEC  (HL)
  E7FE    A6             C              AND  (HL)         ;n. Sec. im Diskblock
  E7FF    21 EA54        C              LD   HL,FDMA-80H  ;FDMA-Zeiger ber.
  E802    11 0080        C              LD   DE,80H
  E805    47             C              LD   B,A          ;n. Sector im FDMA
  E806    04             C              INC  B
  E807    19             C      CPSEC2: ADD  HL,DE
  E808    10 FD          C              DJNZ CPSEC2
  E80A    EB             C              EX   DE,HL
  E80B    41             C              LD   B,C          ;(N)
  E80C    E1             C              POP  HL           ;SECTOR
  E80D    7E             C              LD   A,(HL)
  E80E    34             C              INC  (HL)
  E80F    CB 3F          C      CPSEC3: SRL  A
  E811    10 FC          C              DJNZ CPSEC3       ;B=0 (Kopf1)
                         C      ;
                         C      ;Kopf berechnen
                         C      ;--------------
                         C      ;
  E813    4F             C              LD   C,A
  E814    3A EABD        C              LD   A,(EOT)      ;DSectoren je Spur
  E817    3D             C              DEC  A
  E818    21 EABB        C              LD   HL,SECTR
  E81B    91             C              SUB  C
  E81C    30 04          C              JR   NC,INHEAD    ;Kopf 1
  E81E    2F             C              CPL               ;bitweise negieren
  E81F    06 01          C              LD   B,1          ;Kopf 2
  E821    4F             C              LD   C,A
  E822    79             C      INHEAD: LD   A,C
  E823    35             C              DEC  (HL)
  E824    BE             C              CP   (HL)
  E825    F5             C              PUSH AF
  E826    71             C              LD   (HL),C       ;DSector eintragen
  E827    34             C              INC  (HL)         ;Sec. rel. zu 1
  E828    2B             C              DEC  HL
  E829    70             C              LD   (HL),B       ;Kopf eintragen
  E82A    CB 20          C              SLA  B
  E82C    CB 20          C              SLA  B
  E82E    2B             C              DEC  HL
  E82F    2B             C              DEC  HL           ;UNIT
  E830    3A EAB8        C              LD   A,(UNIT)
  E833    E6 03          C              AND  3            ;Maske fuer LW 1-4
  E835    B0             C              OR   B
  E836    77             C              LD   (HL),A       ;Kopf n, LW x
  E837    F1             C              POP  AF
  E838    C9             C              RET
                         C      ;
                         C      ;Vergleich letzter LW-Zugriff
                         C      ;----------------------------
                         C      ;
  E839    21 EAB7        C      CPLW:   LD   HL,CTAB      ;Vergl. Operation
  E83C    BE             C              CP   (HL)
  E83D    20 21          C              JR   NZ,CPLW1
  E83F    21 EAB7        C      CPLW3:  LD   HL,CTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  E842    11 EAC1        C              LD   DE,RESLT     ;Vergleich LW
  E845    1A             C              LD   A,(DE)
  E846    23             C              INC  HL
  E847    AE             C              XOR  (HL)
  E848    E6 03          C              AND  3            ;nur Bit 0 und 1 vergl.
  E84A    20 14          C              JR   NZ,CPLW1
  E84C    23             C              INC  HL           ;Vergleich Spur
  E84D    13             C              INC  DE
  E84E    13             C              INC  DE
  E84F    13             C              INC  DE
  E850    3A EAC6        C              LD   A,(RESLT+5)  ;Sector+1
  E853    3D             C              DEC  A            ;1. Sec. der next Spur?
  E854    1A             C              LD   A,(DE)
  E855    20 01          C              JR   NZ,CPLW2
  E857    3D             C              DEC  A            ;1 Spur zurueck
  E858    BE             C      CPLW2:  CP   (HL)
  E859    20 05          C              JR   NZ,CPLW1
  E85B    23             C              INC  HL
  E85C    13             C              INC  DE           ;Vergleich Kopf
  E85D    1A             C              LD   A,(DE)
  E85E    BE             C              CP   (HL)
  E85F    C8             C              RET  Z
  E860    04             C      CPLW1:  INC  B
  E861    C9             C              RET
                         C      ;
                         C      ;Sector schreiben
                         C      ;----------------
                         C      ;
  E862    F3             C      WRFLO:  DI
  E863    ED 73 F5E0     C              LD   (SAVSTK),SP
  E867    31 F660        C              LD   SP,BIOSTK
  E86A    E5             C              PUSH HL
  E86B    D5             C              PUSH DE
  E86C    C5             C              PUSH BC
  E86D    C5             C              PUSH BC           ;C=1->Direktory schreiben
  E86E    CD EA14        C              CALL INITFL       ;Floppy initialisieren
  E871    AF             C              XOR  A            ;Fehlermeldung loeschen
  E872    32 EAD2        C              LD   (RWTEST),A
