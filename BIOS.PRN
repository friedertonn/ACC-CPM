                                ;
                                        .PRINTX '--> RAMDISK'
                         C      $INCLUDE RAMDISK.INC
                         C      ;       *************************
                         C      ;       *                       *
                         C      ;       * Praecitronic RAM-Disk *
                         C      ;       *                       *
                         C      ;       *************************
                         C      ;
                         C      ;10.04.2024
                         C      ;
                         C      ;Die RAM-Disk hat eine Organisation von 256 Tracks
                         C      ;und 64 Sectoren/Track (8K / Track).
                         C      ;Track 0 ist fuer CCP + BDOS reserviert (8K Systemtrack).
                         C      ;
  00E0                   C      RDADR   EQU  0E0H         ;Grund-Adresse der RAM-Disk
                         C      ;
  EED4                   C      RDMERK: DEFS 4,0          ;4 Merkzellen fuer den RAM-Disk Test
  EED8    00             C      RDSIZE: DEFB 0            ;RD-Size: 0=256K 1=512K 2=1024K 3=2048K
                         C      ;
                         C      ; RAM-Disk lesen
                         C      ; --------------
                         C      ;
  EED9    CD EEE7        C      RDRDSK: CALL RDARI
  EEDC    ED B2          C              INIR
  EEDE    AF             C              XOR  A
  EEDF    C9             C              RET
                         C      ;
                         C      ; RAM-Disk schreiben
                         C      ; ------------------
                         C      ;
  EEE0    CD EEE7        C      WRRDSK: CALL RDARI
  EEE3    ED B3          C              OTIR
  EEE5    AF             C              XOR  A
  EEE6    C9             C              RET
                         C      ;
                         C      ; Disk-Adresse bestimmen
                         C      ; ----------------------
                         C      ;
  EEE7    3A EAB9        C      RDARI:  LD   A,(TRACK)    ;TTTTTTTT
  EEEA    6F             C              LD   L,A
  EEEB    3A EAB1        C              LD   A,(SECTOR)   ;00SSSSSS
  EEEE    A7             C              AND  A
  EEEF    CA F2D8        C              JP   Z,DERROR     ;Zugriff auf Sektor 0
  EEF2    5F             C              LD   E,A
  EEF3    1D             C              DEC  E            ;CP/A beginnt mit Sektor 1
  EEF4    AF             C              XOR  A
  EEF5    67             C              LD   H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  EEF6    57             C              LD   D,A
  EEF7    29             C              ADD  HL,HL
  EEF8    29             C              ADD  HL,HL
  EEF9    29             C              ADD  HL,HL
  EEFA    29             C              ADD  HL,HL
  EEFB    29             C              ADD  HL,HL
  EEFC    29             C              ADD  HL,HL        ;00TTTTTT TT000000
  EEFD    19             C              ADD  HL,DE        ;00TTTTTT TTSSSSSS
  EEFE    CB 1C          C              RR   H            ;000TTTTT
  EF00    CB 1D          C              RR   L            ;TTTSSSSS
