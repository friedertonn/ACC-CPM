                         C      ;
                         C      ; Test der RAM-Disk - Size (256 / 512 / 1024 / 2048 KByte)
                         C      ; ------------------------
                         C      ;
  EFCF    AF             C      RDTEST: XOR  A            ;Kapazitaet der RAM-Disk testen
  EFD0    D3 E6          C              OUT  (RDADR+6),A  ;H-Adresse ruecksetzen
  EFD2    0E E0          C              LD   C,RDADR      ;Test erfolgt in der 1. RAM-Bank
                         C      ;
                         C      ; Inhalte der 4 RAM-Testzellen sichern
                         C      ;
  EFD4    21 EED4        C              LD   HL,RDMERK    ;Merkzellen im RAM
  EFD7    06 04          C              LD   B,4          ;4 Durchlaeufe
  EFD9    16 04          C              LD   D,4          ;Startwert Extended-Adresse
  EFDB    AF             C      RDTST1: XOR  A
  EFDC    D3 E7          C              OUT  (RDADR+7),A  ;L-Adresse ruecksetzen
  EFDE    7A             C              LD   A,D
  EFDF    D3 E5          C              OUT  (RDADR+5),A  ;Extended-Adresse auswaehlen
  EFE1    ED 78          C              IN   A,(C)
  EFE3    77             C              LD   (HL),A       ;Daten aus der RAM-Disk sichern
  EFE4    23             C              INC  HL           ;Merkzelle++
  EFE5    CB 3A          C              SRL  D            ;0 --> D7 --> D0 --> CY
  EFE7    10 F2          C              DJNZ RDTST1
                         C      ;
                         C      ; 4 Testwerte in die RAM-Disk schreiben
                         C      ;
  EFE9    06 04          C              LD   B,4          ;4 Durchlaeufe
  EFEB    16 04          C              LD   D,4          ;Startwert Extended-Adresse
  EFED    AF             C      RDTST2: XOR  A
  EFEE    D3 E7          C              OUT  (RDADR+7),A  ;L-Adresse ruecksetzen
  EFF0    7A             C              LD   A,D
  EFF1    D3 E5          C              OUT  (RDADR+5),A  ;Extended-Adresse auswaehlen
  EFF3    ED 79          C              OUT  (C),A        ;Testwert in die RAM-Disk schreiben
  EFF5    CB 3A          C              SRL  D            ;0 --> D7 --> D0 --> CY
  EFF7    10 F4          C              DJNZ RDTST2
                         C      ;
                         C      ;Tabelle der Test-Werte (mit *...* sind die zu testenden Werte):
                         C      ;
                         C      ;           RAM-Disk-Size =   256K   512K  1024K  2048K
                         C      ;Extended-Adresse=00000100B    0      0      0     *4*
                         C      ;Extended-Adresse=00000010B    0      0     *2*     2
                         C      ;Extended-Adresse=00000001B    0     *1*     1      1
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                         C      ;Extended-Adresse=00000000B   *0*     0      0      0
                         C      ;
                         C      ; Groesse der RAM-Disk bestimmen
                         C      ;
  EFF9    06 04          C              LD   B,4          ;4 Durchlaeufe
  EFFB    16 04          C              LD   D,4          ;Startwert Extended-Adresse
  EFFD    AF             C      RDTST3: XOR  A
  EFFE    D3 E7          C              OUT  (RDADR+7),A  ;L-Adresse ruecksetzen
